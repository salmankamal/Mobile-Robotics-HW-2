<?xml version="1.0"?>
<!--
  cone.sdf - an orange traffic cone that moves only when told to.

  Spawned by sim.launch.py with cone:=true, 1.5 m ahead of the robot and
  facing the same way.

  The LiDAR is a rendering sensor, so it sees the VISUAL shape. The visual is
  a stack of cylinders approximating a cone; the step that the scan plane
  (z ~ 0.15 m) passes through has radius 0.11 m. The collision shapes are
  frictionless, so the velocity commands below slide the cone without
  tipping it.

  Gazebo topics (bridged by config/bridge_cone.yaml):
    /cone/cmd_vel            Twist in, in the cone's own frame (x forward)
    /cone/ground_truth/odom  true pose of the cone in the world frame
-->
<sdf version="1.10">
  <model name="cone">
    <link name="cone_link">
      <inertial>
        <pose>0 0 0.08 0 0 0</pose>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.02</ixx><iyy>0.02</iyy><izz>0.015</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>

      <!-- Collision: a low, frictionless base and a slimmer body above it. -->
      <collision name="base">
        <pose>0 0 0.02 0 0 0</pose>
        <geometry><box><size>0.30 0.30 0.04</size></box></geometry>
        <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
      </collision>
      <collision name="body">
        <pose>0 0 0.245 0 0 0</pose>
        <geometry><cylinder><radius>0.10</radius><length>0.41</length></cylinder></geometry>
        <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
      </collision>

      <!-- Visual: square base plus four stacked cylinders, tapering upward. -->
      <visual name="base">
        <pose>0 0 0.02 0 0 0</pose>
        <geometry><box><size>0.30 0.30 0.04</size></box></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
      <visual name="step1">
        <pose>0 0 0.07 0 0 0</pose>
        <geometry><cylinder><radius>0.14</radius><length>0.06</length></cylinder></geometry>
        <material><ambient>1.0 0.45 0.0 1</ambient><diffuse>1.0 0.45 0.0 1</diffuse></material>
      </visual>
      <visual name="step2_scan_plane">
        <pose>0 0 0.15 0 0 0</pose>
        <geometry><cylinder><radius>0.11</radius><length>0.10</length></cylinder></geometry>
        <material><ambient>1.0 0.45 0.0 1</ambient><diffuse>1.0 0.45 0.0 1</diffuse></material>
      </visual>
      <visual name="step3">
        <pose>0 0 0.25 0 0 0</pose>
        <geometry><cylinder><radius>0.08</radius><length>0.10</length></cylinder></geometry>
        <material><ambient>1.0 1.0 1.0 1</ambient><diffuse>1.0 1.0 1.0 1</diffuse></material>
      </visual>
      <visual name="step4">
        <pose>0 0 0.375 0 0 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>0.15</length></cylinder></geometry>
        <material><ambient>1.0 0.45 0.0 1</ambient><diffuse>1.0 0.45 0.0 1</diffuse></material>
      </visual>
    </link>

    <!-- Moves the cone at the commanded body-frame velocity. -->
    <plugin filename="gz-sim-velocity-control-system"
            name="gz::sim::systems::VelocityControl">
      <topic>/cone/cmd_vel</topic>
    </plugin>

    <!-- True pose of the cone, from the physics engine. -->
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>cone</robot_base_frame>
      <odom_topic>/cone/ground_truth/odom</odom_topic>
      <tf_topic>/cone/ground_truth_tf</tf_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>2</dimensions>
    </plugin>
  </model>
</sdf>
