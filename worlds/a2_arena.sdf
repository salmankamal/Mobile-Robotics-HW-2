<?xml version="1.0"?>
<!--
  a2_arena.sdf - world for A2.

  A 12 m x 12 m walled arena centred on the origin. By default the robot
  spawns at the origin facing +x, so the world frame and the odom frame
  start aligned.

  Layout (seen from above, +x right, +y up):
    - The central 8 m x 8 m is clear: room for odometry squares up to 3 m.
    - South wall (y = -6) has a 1 m doorway between x = 2 and x = 3.
    - A 1 m x 1 m buttress sticks out of the west wall, x = -6 to -5,
      y = 1 to 2: an inside and then an outside corner for a robot
      following the west wall southwards.
  Walls are 0.5 m tall, well above the LiDAR's scan plane (~0.15 m).
-->
<sdf version="1.10">
  <world name="a2_arena">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- Needed for the LiDAR (a rendering sensor). -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.85 0.88 0.90 1</background>
      <grid>true</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>30 30</size></plane>
          </geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>30 30</size></plane>
          </geometry>
          <material>
            <ambient>0.78 0.78 0.76 1</ambient>
            <diffuse>0.78 0.78 0.76 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===== Arena walls: 0.1 m thick, 0.5 m tall ===== -->
    <model name="walls">
      <static>true</static>

      <!-- North, y = +6, full length -->
      <link name="north">
        <pose>0 6.05 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>12.2 0.1 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>12.2 0.1 0.5</size></box></geometry>
          <material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material></visual>
      </link>

      <!-- East, x = +6 -->
      <link name="east">
        <pose>6.05 0 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1 12.2 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 12.2 0.5</size></box></geometry>
          <material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material></visual>
      </link>

      <!-- West, x = -6 -->
      <link name="west">
        <pose>-6.05 0 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1 12.2 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 12.2 0.5</size></box></geometry>
          <material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material></visual>
      </link>

      <!-- South, y = -6, in two pieces with a doorway from x = 2 to x = 3 -->
      <link name="south_west_part">
        <pose>-2.05 -6.05 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>8.1 0.1 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>8.1 0.1 0.5</size></box></geometry>
          <material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material></visual>
      </link>
      <link name="south_east_part">
        <pose>4.55 -6.05 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>3.1 0.1 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.1 0.1 0.5</size></box></geometry>
          <material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material></visual>
      </link>

      <!-- Buttress on the west wall: inside + outside corners for wall following -->
      <link name="buttress">
        <pose>-5.5 1.5 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>1.0 1.0 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.0 1.0 0.5</size></box></geometry>
          <material><ambient>0.35 0.40 0.45 1</ambient><diffuse>0.35 0.40 0.45 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
